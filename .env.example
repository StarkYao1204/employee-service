# 聊天模型：必须支持 Tool Calling（OpenAI 兼容接口）。
MODEL_PROVIDER=your_value_here
MODEL_NAME=your_value_here
API_KEY=your_value_here
BASE_URL=your_value_here

# Qwen 文本向量模型：走 DashScope 的 OpenAI 兼容接口，构建索引与检索共用。
DASHSCOPE_API_KEY=your_value_here
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024

# MySQL 业务库：业务数据、登录账号和会话索引；密码用原文，不需要 URL 编码。
DB_USER=your_value_here
DB_PASSWORD=your_value_here
DB_HOST=your_value_here
DB_PORT=your_value_here
DB_NAME=your_value_here

# LangGraph 消息、图状态和 Interrupt；相对路径以项目根目录为基准。
CHECKPOINT_DB=runtime/checkpoints.sqlite3

# JWT：复制为 .env 后必须替换示例值。
# 可使用 openssl rand -hex 32 生成随机值。
JWT_SECRET_KEY=your_value_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
